# --- Local API (python -m app.main on host; start Postgres/Redis via AGT_platform/docker-compose.yaml) ---
DATABASE_URL=
REDIS_URL=
MINIO_ENDPOINT=
MINIO_PRESIGN_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=
MINIO_REGION=
MINIO_SECURE=
MINIO_ADDRESSING_STYLE=path
SECRET_KEY=


# --- OAuth (fill in real values; leave blank to disable that provider) ---
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
MULTIMODAL_ANTHROPIC_ASSIGNMENT_PARSING=on

MULTIMODAL_OPENAI_TRIO_RAG_FRONTLOAD=on
RAG_EMBEDDING_BACKEND=openai

MULTIMODAL_RAG_EMBED_UNITS=on

# --- Multimodal grading ---
MULTIMODAL_SAMPLES_PER_MODEL=3
GRADING_SAMPLE_TEMPERATURE=0.3
GRADING_SAMPLES_PER_MODEL=3

MULTIMODAL_OPENAI_TRIO_RAG_FRONTLOAD=auto
MULTIMODAL_INTEGRATION_STRICT_QUALITY=1
MULTIMODAL_LOCAL_TEST_MAX_GRADING_UNITS=0 # grades entire assignment
MULTIMODAL_LLM_TRIO_CHUNKING=on
MULTIMODAL_AUDIO_HALF_SPLIT=on
MULTIMODAL_WHISPER_TRANSCRIBE=auto

# MULTIMODAL_WHISPER_TRANSCRIBE=off # remember to change this so that it can transcribe audio data for the grading pipeline

# finegrained access to hugging face models
HUGGINGFACE_HUB_TOKEN=
MULTIMODAL_LOCAL_TEST_MAX_ASSIGNMENTS=0 # grades all assignments
